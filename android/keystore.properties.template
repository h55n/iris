# Copy to keystore.properties (gitignored) and fill in, or set the IRIS_KEYSTORE* env vars instead.
# Generate the keystore ONCE and back it up somewhere safe off this machine:
#   keytool -genkeypair -v -keystore iris-release.keystore -alias iris -keyalg RSA -keysize 4096 -validity 10000
# Losing the keystore means losing the ability to update an installed app. Never commit it.
storeFile=iris-release.keystore
storePassword=
keyAlias=iris
keyPassword=
